{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://https://prism-app-production-9c9d.up.railway.app/api/:path*"
    },
    {
      "source": "/uploads/:path*",
      "destination": "https://https://prism-app-production-9c9d.up.railway.app/uploads/:path*"
    },
    {
      "source": "/:path*",
      "destination": "/index.html"
    }
  ]
}
