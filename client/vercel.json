{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://REMPLACE_PAR_URL_RAILWAY/api/:path*"
    },
    {
      "source": "/uploads/:path*",
      "destination": "https://REMPLACE_PAR_URL_RAILWAY/uploads/:path*"
    },
    {
      "source": "/:path*",
      "destination": "/index.html"
    }
  ]
}
